# Server Configuration
PORT=3000 # The port the Node.js server will listen on (Hostinger usually provides this via process.env.PORT)

# Supabase Configuration
# Get these from your Supabase Project Settings > API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Email / SMTP Configuration (Hostinger / Google Workspace)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=hello@qalalabs.com
SMTP_PASS=your-smtp-password

# Google Chat Alert Webhook (Instant inbound lead cards in Google Chat Space)
# In Google Chat Space > Space Settings > Apps & integrations > Webhooks > Add webhook
GOOGLE_CHAT_WEBHOOK_URL=https://chat.googleapis.com/v1/spaces/YOUR_SPACE_ID/messages?key=YOUR_KEY&token=YOUR_TOKEN

# Google Chat / Team Notification Emails (Comma-separated)
# Leads will be emailed to hello@qalalabs.com, qalakaar.qalalabs@gmail.com, plus any specified below:
GOOGLE_CHAT_EMAIL=your-space-id@chat.google.com
TEAM_NOTIFICATION_EMAILS=growth@qalalabs.com,founders@qalalabs.com

# Automation & Additional Webhooks (Optional)
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/leads
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=