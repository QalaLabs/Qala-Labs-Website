# Server Configuration
PORT=3000 # The port the Node.js server will listen on (Hostinger usually provides this via process.env.PORT)

# Supabase Configuration
# Get these from your Supabase Project Settings > API

# For development/client-side usage
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# For server-side operations (sync, admin tasks)
# Required for the sync-content script - use the SERVICE ROLE SECRET KEY from Supabase
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Automation & Webhooks
# Optional: Endpoint for lead automation (e.g., n8n, Zapier, HubSpot)
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/leads