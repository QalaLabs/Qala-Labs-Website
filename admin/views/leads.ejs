<%- contentFor('html_attribute') %>
<%- contentFor('extra_css') %>
<%- contentFor('body_attribute') %>
<%- contentFor('content') %>

<div class="container-xxl">

    <div class="py-3 d-flex align-items-sm-center flex-sm-row flex-column">
        <div class="flex-grow-1">
            <h4 class="fs-18 fw-semibold m-0">CRM Leads</h4>
            <p class="text-muted mb-0 fs-13"><%= totalLeads %> total leads in your pipeline</p>
        </div>
        <div class="d-flex gap-2">
            <a href="/leads/export" class="btn btn-outline-secondary btn-sm">
                <i data-feather="download" style="height:14px;width:14px;"></i> Export CSV
            </a>
        </div>
    </div>

    <!-- Filters -->
    <div class="card mb-4">
        <div class="card-body py-3">
            <form method="GET" action="/leads" class="row g-2 align-items-end">
                <div class="col-md-4">
                    <label class="form-label fs-12 text-muted mb-1">Search</label>
                    <input type="text" name="search" class="form-control form-control-sm" placeholder="Name or email…" value="<%= search %>">
                </div>
                <div class="col-md-3">
                    <label class="form-label fs-12 text-muted mb-1">Service</label>
                    <select name="service" class="form-select form-select-sm">
                        <option value="all" <%= service === 'all' ? 'selected' : '' %>>All Services</option>
                        <% services.forEach(s => { %>
                        <option value="<%= s %>" <%= service === s ? 'selected' : '' %>><%= s %></option>
                        <% }) %>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label fs-12 text-muted mb-1">Score</label>
                    <select name="score" class="form-select form-select-sm">
                        <option value="all" <%= score === 'all' ? 'selected' : '' %>>All Scores</option>
                        <option value="high" <%= score === 'high' ? 'selected' : '' %>>High (50+)</option>
                        <option value="medium" <%= score === 'medium' ? 'selected' : '' %>>Medium (30–49)</option>
                        <option value="low" <%= score === 'low' ? 'selected' : '' %>>Low (&lt;30)</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary btn-sm w-100">Filter</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Leads table -->
    <div class="card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0" id="leads-table">
                    <thead class="table-light">
                        <tr>
                            <th class="fs-13">#</th>
                            <th class="fs-13">Name / Email</th>
                            <th class="fs-13">Source</th>
                            <th class="fs-13">Interest</th>
                            <th class="fs-13">Revenue</th>
                            <th class="fs-13">Score</th>
                            <th class="fs-13">Status</th>
                            <th class="fs-13">Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% leads.forEach((lead, i) => {
                            const score = calculateLeadScore(lead);
                            const interest = getLeadInterest(lead);
                            const scoreClass = score >= 50 ? 'success' : score >= 30 ? 'warning' : 'secondary';
                            const name = lead.data?.name || 'Anonymous';
                            const revenue = lead.data?.revenue || lead.data?.budget || '—';
                            const source = (lead.tool_used || '').replace(/_/g, ' ');
                            const status = lead.data?.status || 'new';
                            const statusClass = status === 'qualified' ? 'success' : status === 'contacted' ? 'info' : status === 'lost' ? 'danger' : 'secondary';
                            const date = new Date(lead.created_at).toLocaleDateString('en-IN', { day:'numeric', month:'short', year:'2-digit' });
                        %>
                        <tr class="lead-row" data-id="<%= lead.id %>" style="cursor:pointer;">
                            <td class="text-muted fs-12"><%= i + 1 %></td>
                            <td>
                                <div class="fw-medium fs-13"><%= name %></div>
                                <div class="text-muted fs-12"><%= lead.email %></div>
                            </td>
                            <td><span class="fs-12 text-muted"><%= source %></span></td>
                            <td><span class="badge bg-light text-dark border fs-12"><%= interest %></span></td>
                            <td class="fs-13"><%= revenue %></td>
                            <td>
                                <span class="badge bg-<%= scoreClass %> fs-12"><%= score %></span>
                            </td>
                            <td>
                                <span class="badge bg-<%= statusClass %> bg-opacity-10 text-<%= statusClass %> border border-<%= statusClass %> fs-12"><%= status %></span>
                            </td>
                            <td class="text-muted fs-12"><%= date %></td>
                        </tr>
                        <% }) %>
                        <% if (!leads.length) { %>
                        <tr><td colspan="8" class="text-center text-muted py-5">No leads match your filters.</td></tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer text-muted fs-13">
            Showing <%= leads.length %> of <%= totalLeads %> leads
        </div>
    </div>

</div>

<!-- Lead Detail Modal -->
<div class="modal fade" id="leadModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Lead Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="modal-body">
                <div class="text-center py-4"><div class="spinner-border text-primary" role="status"></div></div>
            </div>
        </div>
    </div>
</div>

<%- contentFor('extra_javascript') %>
<script>
document.querySelectorAll('.lead-row').forEach(function(row) {
    row.addEventListener('click', function() {
        var id = this.dataset.id;
        var modal = new bootstrap.Modal(document.getElementById('leadModal'));
        document.getElementById('modal-body').innerHTML = '<div class="text-center py-4"><div class="spinner-border text-primary" role="status"></div></div>';
        modal.show();

        fetch('/api/leads/' + id)
            .then(function(r) { return r.json(); })
            .then(function(lead) {
                var d = lead.data || {};
                var score = calcScore(lead);
                var scoreClass = score >= 50 ? 'success' : score >= 30 ? 'warning' : 'secondary';
                document.getElementById('modal-body').innerHTML =
                    '<div class="row g-3">' +
                    '<div class="col-md-6"><strong>Name</strong><p class="text-muted">' + (d.name || 'Anonymous') + '</p></div>' +
                    '<div class="col-md-6"><strong>Email</strong><p class="text-muted">' + lead.email + '</p></div>' +
                    '<div class="col-md-6"><strong>Phone</strong><p class="text-muted">' + (d.phone || '—') + '</p></div>' +
                    '<div class="col-md-6"><strong>Revenue / Budget</strong><p class="text-muted">' + (d.revenue || d.budget || '—') + '</p></div>' +
                    '<div class="col-md-6"><strong>Service Interest</strong><p class="text-muted">' + (d.service || lead.tool_used || '—') + '</p></div>' +
                    '<div class="col-md-6"><strong>Lead Score</strong><p><span class="badge bg-' + scoreClass + '">' + score + '</span></p></div>' +
                    '<div class="col-md-6"><strong>Source URL</strong><p class="text-muted">' + (d.source_url || 'Direct') + '</p></div>' +
                    '<div class="col-md-6"><strong>Submitted</strong><p class="text-muted">' + new Date(lead.created_at).toLocaleString() + '</p></div>' +
                    (d.message ? '<div class="col-12"><strong>Message</strong><p class="text-muted">' + d.message + '</p></div>' : '') +
                    '</div>';
            });
    });
});

function calcScore(lead) {
    var score = 0;
    var d = lead.data || {};
    var rev = d.revenue || d.budget || '';
    if (rev.indexOf('50L+') !== -1 || rev.indexOf('25L+') !== -1) score += 50;
    if (rev.indexOf('15L-50L') !== -1 || rev.indexOf('5-25L') !== -1) score += 30;
    if (d.service === 'eCommerce Growth' || d.service === 'Performance Marketing') score += 20;
    if (lead.tool_used === 'agency_network_join' || lead.tool_used === 'creator_onboarding_v2') score += 10;
    return score;
}
</script>
