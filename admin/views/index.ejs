<%- contentFor('html_attribute') %>

<%- contentFor('extra_css') %>

<%- contentFor('body_attribute') %>

<%- contentFor('content') %>

<div class="container-xxl">

    <div class="py-3 d-flex align-items-sm-center flex-sm-row flex-column">
        <div class="flex-grow-1">
            <h4 class="fs-18 fw-semibold m-0">CRM Dashboard</h4>
            <p class="text-muted mb-0 fs-13">Welcome back, <%= user.email %></p>
        </div>
        <div>
            <a href="/leads" class="btn btn-primary btn-sm">
                <i data-feather="users" class="me-1" style="height:14px;width:14px;"></i> View All Leads
            </a>
        </div>
    </div>

    <!-- Stat cards -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-xl-2">
            <div class="card text-center h-100">
                <div class="card-body py-3">
                    <div class="fs-24 fw-bold text-primary"><%= stats.totalLeads %></div>
                    <div class="fs-13 text-muted">Total Leads</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-2">
            <div class="card text-center h-100">
                <div class="card-body py-3">
                    <div class="fs-24 fw-bold text-success"><%= stats.highLeads %></div>
                    <div class="fs-13 text-muted">High Intent</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-2">
            <div class="card text-center h-100">
                <div class="card-body py-3">
                    <div class="fs-24 fw-bold text-warning"><%= stats.medLeads %></div>
                    <div class="fs-13 text-muted">Mid Intent</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-2">
            <div class="card text-center h-100">
                <div class="card-body py-3">
                    <div class="fs-24 fw-bold text-info"><%= stats.caseStudies %></div>
                    <div class="fs-13 text-muted">Case Studies</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-2">
            <div class="card text-center h-100">
                <div class="card-body py-3">
                    <div class="fs-24 fw-bold text-secondary"><%= stats.portfolio %></div>
                    <div class="fs-13 text-muted">Portfolio</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-2">
            <div class="card text-center h-100">
                <div class="card-body py-3">
                    <div class="fs-24 fw-bold text-danger"><%= stats.blogs %></div>
                    <div class="fs-13 text-muted">Blog Posts</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Lead volume chart + recent leads -->
    <div class="row g-3 mb-4">
        <div class="col-xl-5">
            <div class="card h-100">
                <div class="card-header">
                    <h5 class="card-title mb-0">Leads – Last 7 Days</h5>
                </div>
                <div class="card-body">
                    <div id="leads-chart" class="apex-charts"></div>
                </div>
            </div>
        </div>

        <div class="col-xl-7">
            <div class="card h-100">
                <div class="card-header d-flex align-items-center justify-content-between">
                    <h5 class="card-title mb-0">Recent Leads</h5>
                    <a href="/leads" class="btn btn-sm btn-light">View All</a>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="fs-13">Name / Email</th>
                                    <th class="fs-13">Interest</th>
                                    <th class="fs-13">Score</th>
                                    <th class="fs-13">Date</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% recentLeads.forEach(lead => {
                                    const score = calculateLeadScore(lead);
                                    const interest = getLeadInterest(lead);
                                    const scoreClass = score >= 50 ? 'success' : score >= 30 ? 'warning' : 'secondary';
                                    const name = lead.data?.name || 'Anonymous';
                                    const date = new Date(lead.created_at).toLocaleDateString('en-IN', { day:'numeric', month:'short' });
                                %>
                                <tr>
                                    <td>
                                        <div class="fw-medium fs-13"><%= name %></div>
                                        <div class="text-muted fs-12"><%= lead.email %></div>
                                    </td>
                                    <td><span class="badge bg-light text-dark border fs-12"><%= interest %></span></td>
                                    <td><span class="badge bg-<%= scoreClass %>"><%= score %></span></td>
                                    <td class="text-muted fs-12"><%= date %></td>
                                </tr>
                                <% }) %>
                                <% if (!recentLeads.length) { %>
                                <tr><td colspan="4" class="text-center text-muted py-4">No leads yet.</td></tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div> <!-- container -->

<%- contentFor('extra_javascript') %>
<script src="/libs/apexcharts/apexcharts.min.js"></script>
<script>
(function() {
    var raw = <%- leadsLast7 %>;
    var labels = raw.map(function(d) { return d.label; });
    var counts = raw.map(function(d) { return d.count; });

    var options = {
        chart: { type: 'area', height: 220, toolbar: { show: false }, sparkline: { enabled: false } },
        series: [{ name: 'Leads', data: counts }],
        xaxis: { categories: labels, labels: { style: { fontSize: '11px' } } },
        yaxis: { min: 0, tickAmount: 3, labels: { style: { fontSize: '11px' } } },
        fill: { type: 'gradient', gradient: { shadeIntensity: 1, opacityFrom: 0.4, opacityTo: 0.05 } },
        colors: ['#5B6CF0'],
        stroke: { curve: 'smooth', width: 2 },
        dataLabels: { enabled: false },
        grid: { borderColor: '#f0f0f0' },
        tooltip: { theme: 'light' }
    };
    new ApexCharts(document.querySelector('#leads-chart'), options).render();
})();
</script>
